# Copy to config.env (git-ignored) and fill in your own values.
# Docker Compose passes config.env to the container; never commit it.

# OpenWeather API key (One Call 4.0 needs a One Call subscription)
OPENWEATHER_APIKEY=
# Key of the One Call 4.0 subscription; used when FORECAST_API=onecall4, falls back to the key above
OPENWEATHER4_APIKEY=

# Which OpenWeather forecast to use:
#   onecall4   One Call 4.0 hourly forecast (needs the One Call by Call subscription)
#   forecast25 the free 2.5 forecast, one entry per three hours
FORECAST_API=onecall4

# Where the weather is checked
LATITUDE=2.927761
LONGITUDE=101.897999

# Your WhatsApp number in international format, for example +60123456789
PHONENUMBER=

# Twilio account and the WhatsApp sandbox number you joined
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886

# Local time of the daily check and its time zone
ALERT_TIME=07:00
TZ=Asia/Kuala_Lumpur
